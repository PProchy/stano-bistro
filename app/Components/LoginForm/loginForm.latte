<div class="login-page min-vh-100 d-flex align-items-center justify-content-center p-3" style="background-color: #e9ecef;">
    <div class="login-box w-100">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <img src="{$basePath}/images/logo.png" alt="Stano Bistro" class="mb-3" style="max-height: 80px;">
                <h4 class="mb-0"><b>Stano</b> Bistro</h4>
                <p class="text-muted mb-0">Administrace</p>
            </div>
            <div class="card-body">
                <form n:name="loginForm">
                    <div n:foreach="$form->errors as $error"
                         class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>{$error}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <div class="form-group mb-3">
                        <div class="input-group">
                            <input n:name="email" type="email" class="form-control" placeholder="Email">
                            <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="input-group">
                            <input n:name="password" type="password" class="form-control" placeholder="Heslo">
                            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        </div>
                    </div>

                    <div class="d-grid">
                        {input login, class => 'btn btn-primary btn-block'}
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
